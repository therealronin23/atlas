#!/usr/bin/env bash
# Pre-commit hook: gate RÁPIDO (mypy + tests mapeados) antes de cada commit.
# Si el gate falla, el commit se aborta.
#
# 2026-07-10: la suite completa (`pytest tests/ -q`) acumula ~7.5GB RSS y el
# daemon earlyoom del sistema la mata con SIGTERM SIEMPRE — el hook viejo
# nunca terminaba de correr. Por eso este hook mide SOLO lo staged: mypy de
# los .py bajo src/ y pytest de los tests impactados. La suite completa sigue
# existiendo (ColdUpdateBatcher / CI) o corre aquí a mano con
# ATLAS_PRECOMMIT_FULL=1.
#
# 2026-07-29: el mapeo por convención de nombres (`src/<stem>.py` ->
# `tests/test_<stem>*.py`) resultó ciego en dos direcciones y dejó pasar un
# cambio que rompía los 37 tests del tronco MCP. Se sustituye por un mapeo por
# REFERENCIA sobre TODO lo staged, en atlas.engineering.impacted_tests.
# Sigue siendo un gate rápido, no una prueba de cobertura.
#
# 2026-07-29, corrección medida: el "~7,5 GB + earlyoom la mata SIEMPRE" de
# arriba quedó OBSOLETO y nunca se actualizó aquí. 2262de41 (julio) cacheó el
# ONNX de FastEmbedEmbedder por proceso y bajó el pico a ~1,9 GB. Medido hoy con
# /usr/bin/time -v: 2,36 GB de pico, 5:47 de reloj, exit 0 con earlyoom vivo
# (PID 1184). La suite completa YA NO muere por RAM; la razón para no correrla
# en cada commit es el TIEMPO. Se conserva el párrafo de arriba como historia
# de por qué nació el hook, no como estado actual.
#
# Instalacion: git config core.hooksPath .githooks

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Activar venv
if [ -f .venv/bin/activate ]; then
    # shellcheck source=/dev/null
    source .venv/bin/activate
fi

export PYTHONPATH=src

# Escape explícito: suite completa a la antigua, uso manual consciente.
if [ "${ATLAS_PRECOMMIT_FULL:-0}" = "1" ]; then
    echo "→ ATLAS_PRECOMMIT_FULL=1: ejecutando suite completa (puede tardar / consumir mucha RAM)..."
    if ! python -m pytest tests/ -q 2>&1; then
        echo ""
        echo "✗ TESTS FALLIDOS. Commit cancelado."
        exit 1
    fi
    echo "✓ Suite completa OK. Procediendo con el commit."
    exit 0
fi

staged_files="$(git diff --cached --name-only --diff-filter=ACM)"

staged_src_py="$(printf '%s\n' "$staged_files" | grep -E '^src/.*\.py$' || true)"

# --- (a) mypy: solo los .py staged bajo src/ ---
if [ -n "$staged_src_py" ]; then
    echo "→ mypy (solo .py staged bajo src/)..."
    # shellcheck disable=SC2086
    if ! MYPYPATH=src python -m mypy $staged_src_py 2>&1; then
        echo ""
        echo "✗ MYPY FALLÓ. Commit cancelado."
        exit 1
    fi
    echo "✓ mypy OK."
else
    echo "→ mypy: sin .py staged bajo src/, se salta."
fi

# --- (b) pytest: los tests que el cambio staged puede romper ---
# El mapeo vive en atlas.engineering.impacted_tests (probado en
# tests/test_impacted_tests.py), no aquí: el glob por stem que había en este
# hook dejó pasar el 2026-07-29 un cambio en docs/design/mcp_catalog.yaml que
# rompía los 37 tests del tronco MCP. Los ficheros de datos no mapeaban a nada
# y el glob alcanzaba 1 de los 16 tests del módulo. Ahora se mapea por
# REFERENCIA y entra TODO lo staged, no sólo los .py.
if ! mapped_tests="$(printf '%s\n' "$staged_files" \
        | grep -v '^$' \
        | xargs -r python -m atlas.engineering.impacted_tests)"; then
    echo ""
    echo "✗ El mapeo de tests impactados falló. Commit cancelado (fail-closed)."
    echo "  Escape consciente: ATLAS_PRECOMMIT_FULL=1 git commit ..."
    exit 1
fi

if [ -n "$mapped_tests" ]; then
    echo "→ pytest (solo tests mapeados desde lo staged)..."
    # shellcheck disable=SC2086
    if ! python -m pytest $mapped_tests -q 2>&1; then
        echo ""
        echo "✗ TESTS FALLIDOS. Commit cancelado."
        exit 1
    fi
    echo "✓ pytest OK."
else
    echo "→ pytest: sin tests mapeados desde lo staged, se salta (NO se corre la suite completa)."
fi

echo "✓ Gate rápido OK. Procediendo con el commit."
echo "  (suite completa: ColdUpdateBatcher/CI, o a mano con ATLAS_PRECOMMIT_FULL=1)"
