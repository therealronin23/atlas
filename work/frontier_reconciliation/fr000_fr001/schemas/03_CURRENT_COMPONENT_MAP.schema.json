{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "capability_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "component_id": {
      "pattern": "^COMP-[0-9A-F]{8,}$",
      "type": "string"
    },
    "component_kind": {
      "minLength": 1,
      "type": "string"
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "current": {
      "const": true
    },
    "direct_test_locators": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "epistemic_limit": {
      "minLength": 1,
      "type": "string"
    },
    "excluded_test_locators": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "independence_key": {
      "minLength": 1,
      "type": "string"
    },
    "maturity": {
      "enum": [
        "MISSING",
        "RESEARCH_ONLY",
        "PROPOSED_DESIGN",
        "ACCEPTED_DESIGN",
        "CODE_PRESENT",
        "TESTED",
        "WIRED",
        "RUNTIME_CONFIGURED",
        "LIVE_VERIFIED",
        "PRODUCT_ACCEPTED",
        "SUPERSEDED",
        "CONTRADICTED",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "maturity_transitions": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "evidence_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "locator": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "minItems": 1,
                "type": "array"
              },
              {
                "minProperties": 1,
                "type": "object"
              }
            ]
          },
          "scope_limit": {
            "minLength": 1,
            "type": "string"
          },
          "to": {
            "enum": [
              "MISSING",
              "RESEARCH_ONLY",
              "PROPOSED_DESIGN",
              "ACCEPTED_DESIGN",
              "CODE_PRESENT",
              "TESTED",
              "WIRED",
              "RUNTIME_CONFIGURED",
              "LIVE_VERIFIED",
              "PRODUCT_ACCEPTED",
              "SUPERSEDED",
              "CONTRADICTED",
              "UNKNOWN"
            ],
            "type": "string"
          }
        },
        "required": [
          "to",
          "evidence_ids",
          "locator"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "owner": {
      "minLength": 1,
      "type": "string"
    },
    "program": {
      "enum": [
        "P00",
        "P01",
        "P02",
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "P09",
        "P10",
        "P11",
        "P12",
        "P04P05",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "public_contracts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "purpose": {
      "minLength": 1,
      "type": "string"
    },
    "purpose_confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "related_frontier_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "source_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "tested_property_locators": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "component_id",
    "component_kind",
    "name",
    "purpose",
    "purpose_confidence",
    "owner",
    "program",
    "source_paths",
    "public_contracts",
    "maturity",
    "maturity_transitions",
    "direct_test_locators",
    "tested_property_locators",
    "excluded_test_locators",
    "related_frontier_ids",
    "current",
    "confidence",
    "independence_key",
    "epistemic_limit"
  ],
  "title": "FR-000 current implementation-unit record",
  "type": "object"
}
