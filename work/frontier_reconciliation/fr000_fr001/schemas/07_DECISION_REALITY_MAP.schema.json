{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_scope": {
      "enum": [
        "CURRENT",
        "CURRENT_CANON_REGISTRY_CLAIM",
        "GRAPH_ENDPOINT_ONLY",
        "HISTORICAL_OR_EXTERNAL_DISPOSITION"
      ],
      "type": "string"
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "contradicts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "current": {
      "type": "boolean"
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_id": {
      "minLength": 2,
      "pattern": "^[^\\s].*[^\\s]$|^[^\\s]$",
      "type": "string"
    },
    "decision_subject_key": {
      "minLength": 1,
      "type": "string"
    },
    "depends_on": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_qualification": {
      "type": [
        "string",
        "null"
      ]
    },
    "falsifier": {
      "minLength": 1,
      "type": "string"
    },
    "falsifier_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN",
        "NOT_RUN_IN_FR000_FR001",
        "NOT_APPLICABLE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "implemented_by": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "independence_key": {
      "minLength": 1,
      "type": "string"
    },
    "locators": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "non_supersession_relations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "program": {
      "enum": [
        "P00",
        "P01",
        "P02",
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "P09",
        "P10",
        "P11",
        "P12",
        "P04P05",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "programs_related": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "record_kind": {
      "minLength": 1,
      "type": "string"
    },
    "runtime_evidence": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "semantic_duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_independence": {
      "minLength": 1,
      "type": "string"
    },
    "source_occurrence_count": {
      "minimum": 1,
      "type": "integer"
    },
    "source_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PROVISIONAL",
        "SUPERSEDED",
        "REJECTED",
        "CONTRADICTED",
        "HISTORICAL",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "superseded_by": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "supersedes": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "tested_by": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "unique_content_hash_count": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "decision_id",
    "record_kind",
    "title",
    "date",
    "status",
    "source_status",
    "authority",
    "authority_scope",
    "current",
    "program",
    "programs_related",
    "locators",
    "supersedes",
    "superseded_by",
    "contradicts",
    "depends_on",
    "implemented_by",
    "tested_by",
    "runtime_evidence",
    "non_supersession_relations",
    "falsifier",
    "falsifier_status",
    "source_independence",
    "source_occurrence_count",
    "unique_content_hash_count",
    "semantic_duplicate_of",
    "decision_subject_key",
    "confidence",
    "independence_key"
  ],
  "title": "FR-001 decision reality record",
  "type": "object"
}
