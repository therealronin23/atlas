{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "oneOf": [
    {
      "properties": {
        "record_kind": {
          "const": "FRONTIER_R0"
        }
      },
      "required": [
        "frontier_id",
        "name",
        "program",
        "pack_assessment",
        "pack_disposition",
        "pack_epistemic_status",
        "assessment",
        "examined",
        "evidence_ids",
        "referenced_current_sources_present",
        "mapping_note",
        "case_for",
        "case_against",
        "merge_group",
        "split_group"
      ]
    },
    {
      "properties": {
        "record_kind": {
          "enum": [
            "SOURCE",
            "COMPONENT",
            "DECISION"
          ],
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_locator",
        "mapping_status",
        "frontier_ids",
        "candidate_program",
        "reason"
      ]
    }
  ],
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_locator": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      ]
    },
    "assessment": {
      "enum": [
        "CONFIRMED",
        "REFORMULATE",
        "MERGE_CANDIDATE",
        "SPLIT_CANDIDATE",
        "DELETE_CANDIDATE",
        "SUPERSEDED",
        "HISTORICAL",
        "NEW_EVIDENCE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "candidate_program": {
      "enum": [
        "P00",
        "P01",
        "P02",
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "P09",
        "P10",
        "P11",
        "P12",
        "P04P05",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "case_against": {
      "minLength": 1,
      "type": "string"
    },
    "case_for": {
      "minLength": 1,
      "type": "string"
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "examined": {
      "const": true
    },
    "frontier_id": {
      "pattern": "^FR-P(?:0[0-9]|1[0-2])-[0-9]{3}$",
      "type": "string"
    },
    "frontier_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "independence_key": {
      "minLength": 1,
      "type": "string"
    },
    "mapping_note": {
      "minLength": 1,
      "type": "string"
    },
    "mapping_status": {
      "enum": [
        "MAPPED",
        "DUPLICATE",
        "SUPERSEDED",
        "HISTORICAL",
        "IRRELEVANT",
        "NEW_FRONTIER",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "merge_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "pack_assessment": {
      "minLength": 1,
      "type": "string"
    },
    "pack_disposition": {
      "minLength": 1,
      "type": "string"
    },
    "pack_epistemic_status": {
      "minLength": 1,
      "type": "string"
    },
    "program": {
      "pattern": "^(?:P(?:0[0-9]|1[0-2])|P04P05)$",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "record_kind": {
      "enum": [
        "FRONTIER_R0",
        "SOURCE",
        "COMPONENT",
        "DECISION"
      ],
      "type": "string"
    },
    "referenced_current_sources_present": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "split_group": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "record_kind",
    "confidence",
    "independence_key"
  ],
  "title": "FR-001 frontier and current-artifact cross-mapping record",
  "type": "object"
}
