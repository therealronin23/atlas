{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/decision_evidence.schema.json",
  "title": "AtlasDecisionEvidence",
  "description": "Comparison record that qualifies, but never replaces, a decision-registry disposition.",
  "type": "object",
  "required": [
    "id",
    "decision_id",
    "program",
    "state",
    "alternatives",
    "evidence_ids",
    "recommendation",
    "confidence",
    "falsifiers",
    "revisit_triggers",
    "operator_decision_required",
    "dossier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DEM-[A-Z0-9][A-Z0-9-]*$"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "program": {
      "type": "string",
      "pattern": "^P(0[0-9]|1[0-2])$"
    },
    "state": {
      "type": "string",
      "enum": [
        "EVIDENCE_QUALIFIED",
        "PROVISIONAL",
        "EXPERIMENT",
        "REQUIRES_OPERATOR",
        "BLOCKED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "disposition", "tradeoffs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "disposition": {
            "type": "string",
            "enum": ["RETAINED", "RECOMMENDED", "REJECTED", "EXPERIMENT"]
          },
          "tradeoffs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^EVD-[A-Z0-9][A-Z0-9-]*$"}
    },
    "recommendation": {"type": "string", "minLength": 1},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "revisit_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "operator_decision_required": {"type": "boolean"},
    "dossier": {"type": "string", "pattern": "^docs/canon/decision_dossiers/.+\\.md$"}
  },
  "additionalProperties": false
}
